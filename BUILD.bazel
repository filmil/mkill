load("@gazelle//:def.bzl", "gazelle")
load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

# gazelle:prefix mkill
gazelle(name = "gazelle")

go_library(
    name = "mkill_lib",
    srcs = [
        "chart.go",
        "main.go",
    ],
    importpath = "mkill",
    visibility = ["//visibility:private"],
    deps = [
        "@com_github_charmbracelet_bubbles//table",
        "@com_github_charmbracelet_bubbletea//:bubbletea",
        "@com_github_charmbracelet_lipgloss//:lipgloss",
        "@com_github_charmbracelet_x_ansi//:ansi",
        "@com_github_gizak_termui_v3//:termui",
        "@com_github_gizak_termui_v3//widgets",
        "@com_github_shirou_gopsutil_v3//mem",
        "@com_github_shirou_gopsutil_v3//process",
    ],
)

go_test(
    name = "mkill_test",
    srcs = [
        "chart_test.go",
        "main_test.go",
    ],
    embed = [":mkill_lib"],
    deps = [
        "@com_github_charmbracelet_bubbles//table",
        "@com_github_charmbracelet_bubbletea//:bubbletea",
    ],
)

go_binary(
    name = "mkill",
    embed = [":mkill_lib"],
    visibility = ["//visibility:public"],
)
